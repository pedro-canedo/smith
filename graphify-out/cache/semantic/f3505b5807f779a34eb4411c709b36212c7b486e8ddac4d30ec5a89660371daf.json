{"nodes": [{"id": "_github_workflows_ci_ci_workflow", "label": "CI Workflow", "file_type": "document", "source_file": ".github/workflows/ci.yml", "source_location": "name: CI", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_github_workflows_ci_test", "label": "test job (3-platform matrix)", "file_type": "concept", "source_file": ".github/workflows/ci.yml", "source_location": "jobs.test", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only job that needs a matrix: crossterm is the terminal backend and the shell tool's process-group kill is cfg(unix), so platform-divergent code lives here. fail-fast:false keeps one red platform from hiding the state of the other two."}, {"id": "_github_workflows_ci_lint", "label": "lint job (fmt + clippy)", "file_type": "concept", "source_file": ".github/workflows/ci.yml", "source_location": "jobs.lint", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "fmt and clippy are platform-independent for this codebase, so running them on all three platforms would burn CI minutes on identical output."}, {"id": "_github_workflows_ci_msrv", "label": "msrv job (Rust 1.88.0)", "file_type": "concept", "source_file": ".github/workflows/ci.yml", "source_location": "jobs.msrv", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "rust-toolchain.toml pins stable and outranks rustup default, so the toolchain must be selected explicitly with +1.88.0 \u2014 otherwise the job silently checks with stable and guarantees nothing."}, {"id": "_github_workflows_ci_acceptance", "label": "acceptance job (criterion 8 smoke)", "file_type": "concept", "source_file": ".github/workflows/ci.yml", "source_location": "jobs.acceptance", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The serde round trip is unit-tested, but the criterion is about the pipeline \u2014 that stdout carries the JSON alone with every progress line on stderr, and that a real jq accepts it. Ubuntu only: it asserts a property of our own output, not of the platform."}, {"id": "_github_workflows_ci_fake_provider", "label": "fake_provider.py fixture", "file_type": "code", "source_file": ".github/workflows/ci.yml", "source_location": ".github/fixtures/fake_provider.py", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_github_workflows_ci_project_config_layer", "label": "Project config layer used by CI acceptance", "file_type": "rationale", "source_file": ".github/workflows/ci.yml", "source_location": "Criterion 8 steps", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The project config layer, not the global one: it applies without depending on the runner's HOME, and --cwd puts the session store and the tool sandbox in the same throwaway directory."}], "edges": [{"source": "_github_workflows_ci_ci_workflow", "target": "_github_workflows_ci_test", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/workflows/ci.yml", "source_location": "jobs", "weight": 1.0}, {"source": "_github_workflows_ci_ci_workflow", "target": "_github_workflows_ci_lint", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/workflows/ci.yml", "source_location": "jobs", "weight": 1.0}, {"source": "_github_workflows_ci_ci_workflow", "target": "_github_workflows_ci_msrv", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/workflows/ci.yml", "source_location": "jobs", "weight": 1.0}, {"source": "_github_workflows_ci_ci_workflow", "target": "_github_workflows_ci_acceptance", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/workflows/ci.yml", "source_location": "jobs", "weight": 1.0}, {"source": "_github_workflows_ci_acceptance", "target": "_github_workflows_ci_fake_provider", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/workflows/ci.yml", "source_location": "Start the fixture provider", "weight": 1.0}, {"source": "_github_workflows_ci_acceptance", "target": "_github_workflows_ci_project_config_layer", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/workflows/ci.yml", "source_location": "Criterion 8", "weight": 1.0}, {"source": "_github_workflows_ci_acceptance", "target": "claude_headless_mode", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": ".github/workflows/ci.yml", "source_location": "--output-format json / stream-json", "weight": 1.0}], "hyperedges": []}