{"nodes": [{"id": "claude_smith_agent", "label": "Smith (terminal AI coding agent)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_smith_core", "label": "smith-core crate", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_smith_providers", "label": "smith-providers crate", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_smith_tools", "label": "smith-tools crate", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_smith_mcp", "label": "smith-mcp crate", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_smith_persist", "label": "smith-persist crate", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_smith_tui", "label": "smith-tui crate", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_smith_cli", "label": "smith-cli crate", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_llmprovider_trait", "label": "LlmProvider trait", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_tool_trait", "label": "Tool trait", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_toolexecutor_trait", "label": "ToolExecutor trait", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_agent_run_turn", "label": "Agent::run_turn", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_agent_run_one_tool", "label": "Agent::run_one_tool", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_action_agentevent_pattern", "label": "Action/AgentEvent loop pattern", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "smith-tui never talks to smith-providers or smith-tools directly, only through the Action/AgentEvent channels; this keeps the UI decoupled from orchestration so any new capability that must reach the UI needs a new AgentEvent variant, an emitter, and a handler arm rather than a direct call."}, {"id": "claude_tool_interception_pattern", "label": "Tool interception pattern (ask_user)", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ask_user is registered normally in ToolRegistry but its execute() is a stub that always errors; Agent::run_one_tool special-cases it by name before the generic dispatch and round-trips through a oneshot channel to the TUI instead. Use this pattern for any tool whose result depends on interactive UI state rather than trying to make ToolExecutor::execute itself interactive."}, {"id": "claude_permission_model", "label": "Permission model (PermissionClass/PermissionPolicy/plan_gated)", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "plan_gated blocks every tool above ReadOnly outright regardless of PermissionPolicy - even Skip doesn't bypass an unapproved plan - so plan approval is an independent, stronger gate layered on top of the per-tool permission classes."}, {"id": "claude_session_goal_persistence", "label": "Session/goal persistence", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Session history and the goal are kept under the project's .smith/ directory (gitignored) rather than the global ~/.smith/config.toml, so project-scoped conversational state stays separate from global provider/model configuration."}, {"id": "claude_provider_model_switching", "label": "Provider/model switching mid-session", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "messages: Vec<Message> lives independently of the Arc<dyn LlmProvider>, so conversation history carries over whether /model changes just the model or rebuilds the Agent against a different provider entirely."}, {"id": "claude_ask_user_tool", "label": "ask_user tool", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_run_bash_tool", "label": "run_bash tool", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_toolregistry", "label": "ToolRegistry", "file_type": "conce